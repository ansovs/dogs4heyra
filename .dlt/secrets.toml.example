# Copy this file to .dlt/secrets.toml and fill in your values.
# .dlt/secrets.toml is gitignored — never commit real credentials.
#
# To get BigQuery sandbox credentials:
#   1. Go to https://console.cloud.google.com/bigquery and create/select a
#      project (no billing account required for the sandbox tier).
#   2. Create a service account: IAM & Admin > Service Accounts > Create.
#      Grant it "BigQuery Data Editor" and "BigQuery Job User" roles.
#   3. Create a JSON key for that service account and download it.
#   4. Copy project_id, private_key, and client_email from the JSON below.

[destination.bigquery]
location = "US"

[destination.bigquery.credentials]
project_id = "please_set_me_up"
private_key = "please_set_me_up"
client_email = "please_set_me_up"
